# openai or anthropic
# An Anthropic key (sk-ant-) needs LLM_PROVIDER=anthropic. Leave LLM_BASE_URL empty.
LLM_PROVIDER=openai
LLM_API_KEY=
# Leave empty to use the provider default (gpt-4.1-mini or claude-haiku-4-5)
LLM_MODEL=
# Optional OpenAI-compatible base URL, for example http://localhost:11434/v1
# Do not put https://api.anthropic.com here.
LLM_BASE_URL=
